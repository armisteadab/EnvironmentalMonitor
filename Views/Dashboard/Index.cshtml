@model EnvironmentalMonitor.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["HeaderTime"] = Model.AsOf.ToString("MMM d, yyyy  h:mm tt");
    ViewData["LastDataTime"] = Model.AsOf.ToString("MMM d, yyyy h:mm:ss tt");
}

<!-- ===================== Row 1: Sensor cards + Map ===================== -->
<div class="dash-row row-cards">
    @foreach (var card in Model.Cards)
    {
        <div class="card-panel sensor-card">
            <div class="sensor-card-head">
                <span>@card.Name.ToUpper()</span>
                <span class="online-badge" style="color:@card.ColorHex;">
                    <span class="dot" style="background:@card.ColorHex;"></span>
                    @(card.Online ? "Online" : "Offline")
                </span>
            </div>
            <div class="sensor-card-body">
                <div>
                    <span class="sensor-temp-f" style="color:@card.ColorHex;">@card.TempF.ToString("0")</span>
                    <span class="sensor-temp-f" style="font-size:1.1rem;color:@card.ColorHex;"> &deg;F</span>
                    <div class="sensor-temp-c">@card.TempC.ToString("0") &deg;C</div>
                </div>
                <div class="sensor-icon">&#127777;</div>
            </div>
            <div class="sensor-humidity">
                <span>&#128167;</span> @card.Humidity.ToString("0") %
            </div>
        </div>
    }

</div>

<!-- ===================== Row 2: Charts ===================== -->
<div class="dash-row row-charts">
    <div class="card-panel chart-panel chart-zoomable" data-chart-target="tempChart">
        <div class="chart-panel-head">
            <h3>Temperature (&deg;F) - Last 24 Hours</h3>
            <span class="chart-zoom-hint" title="Click to expand">&#128470;</span>
        </div>
        <canvas id="tempChart"></canvas>
    </div>
    <div class="card-panel chart-panel chart-zoomable" data-chart-target="humChart">
        <div class="chart-panel-head">
            <h3>Humidity (%) - Last 24 Hours</h3>
            <span class="chart-zoom-hint" title="Click to expand">&#128470;</span>
        </div>
        <canvas id="humChart"></canvas>
    </div>
</div>

<!-- ===================== Row 3: Outdoor CO2 Chart ===================== -->
<!-- Note: the "Recent Readings" table that used to live here now has its own
     dedicated page, linked from the "Recent Readings" item in the sidebar
     (same pattern as "AI Report Chat" moving off the Dashboard). -->

<div class="dash-row row-bottom">
    <div class="card-panel chart-panel chart-zoomable" style="flex: 1 1 100%;" data-chart-target="co2Chart">
        <div class="chart-panel-head">
            <h3>Outdoor CO&#8322; (ppm) - Last 24 Hours</h3>
            <span class="chart-zoom-hint" title="Click to expand">&#128470;</span>
        </div>
        <canvas id="co2Chart"></canvas>
    </div>

</div>

<!-- ===================== Fullscreen Chart Zoom Modal ===================== -->
<div class="chart-zoom-overlay" id="chartZoomOverlay">
    <div class="chart-zoom-dialog">
        <div class="chart-zoom-header">
            <h3 id="chartZoomTitle"></h3>
            <button type="button" class="chart-zoom-close" id="chartZoomClose" aria-label="Close">&times;</button>
        </div>
        <div class="chart-zoom-body">
            <canvas id="chartZoomCanvas"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
        const tempSeries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TempSeries));
        const humSeries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HumiditySeries));
        const outsideCo2Series = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OutsideCo2Series));



        const colors = {
            "Outdoor": "#3b82f6",
            "Upstairs": "#f59e0b",
            "Basement": "#10b981"
        };

        function buildDatasets(seriesObj) {
            return Object.keys(seriesObj).map(name => ({
                label: name,
                data: seriesObj[name],
                borderColor: colors[name] || "#888",
                backgroundColor: colors[name] || "#888",
                spanGaps: true,
                tension: 0.3,
                pointRadius: 2,
                borderWidth: 2
            }));
        }

        // Chart configs are kept in a registry (keyed by canvas id) alongside each
        // chart's live Chart.js instance, so the zoom modal below can re-create the
        // exact same chart (same data/options) larger, rather than trying to resize
        // or reparent the original <canvas> element.
        const chartRegistry = {};

        function registerChart(canvasId, config, title) {
            const instance = new Chart(document.getElementById(canvasId), config);
            chartRegistry[canvasId] = { config, title, instance };
            return instance;
        }

        registerChart('tempChart', {
            type: 'line',
            data: { labels: chartLabels, datasets: buildDatasets(tempSeries) },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'top', align: 'start' } },
                scales: {
                    x: { ticks: { maxTicksLimit: 8 } },
                    y: { title: { display: false } }
                }
            }
        }, 'Temperature (\u00b0F) - Last 24 Hours');

        registerChart('humChart', {
            type: 'line',
            data: { labels: chartLabels, datasets: buildDatasets(humSeries) },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'top', align: 'start' } },
                scales: {
                    x: { ticks: { maxTicksLimit: 8 } },
                    y: { min: 0, max: 100 }
                }
            }
        }, 'Humidity (%) - Last 24 Hours');

        registerChart('co2Chart', {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Outdoor',
                    data: outsideCo2Series,
                    borderColor: colors['Outdoor'],
                    backgroundColor: colors['Outdoor'],
                    spanGaps: true,
                    tension: 0.3,
                    pointRadius: 2,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'top', align: 'start' } },
                scales: {
                    x: { ticks: { maxTicksLimit: 8 } },
                    y: { title: { display: false } }
                }
            }
        }, 'Outdoor CO\u2082 (ppm) - Last 24 Hours');

        // ---- Click-to-zoom: expand any dashboard chart to a fullscreen modal ----
        (function () {
            const overlay = document.getElementById('chartZoomOverlay');
            const titleEl = document.getElementById('chartZoomTitle');
            const zoomCanvas = document.getElementById('chartZoomCanvas');
            const closeBtn = document.getElementById('chartZoomClose');
            let zoomChartInstance = null;

            function openZoom(canvasId) {
                const entry = chartRegistry[canvasId];
                if (!entry) return;

                if (zoomChartInstance) {
                    zoomChartInstance.destroy();
                    zoomChartInstance = null;
                }

                titleEl.textContent = entry.title;

                // Deep-clone the original config so the zoomed chart is fully
                // independent of the small dashboard chart (destroying one must
                // never affect the other).
                const clonedConfig = JSON.parse(JSON.stringify(entry.config));
                clonedConfig.options = clonedConfig.options || {};
                clonedConfig.options.responsive = true;
                clonedConfig.options.maintainAspectRatio = false;

                zoomChartInstance = new Chart(zoomCanvas, clonedConfig);

                overlay.classList.add('open');
                document.body.style.overflow = 'hidden';
            }

            function closeZoom() {
                overlay.classList.remove('open');
                document.body.style.overflow = '';
                if (zoomChartInstance) {
                    zoomChartInstance.destroy();
                    zoomChartInstance = null;
                }
            }

            document.querySelectorAll('.chart-zoomable').forEach(function (panel) {
                panel.addEventListener('click', function () {
                    openZoom(panel.getAttribute('data-chart-target'));
                });
            });

            closeBtn.addEventListener('click', closeZoom);
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) closeZoom();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && overlay.classList.contains('open')) closeZoom();
            });
        })();

        // ---- Auto-reload the dashboard every 5 minutes ----
        setTimeout(function () {
            window.location.reload();
        }, 5 * 60 * 1000);

    </script>
}


