@model EnvironmentalMonitor.Models.AlertsIndexViewModel
@{
    ViewData["Title"] = "Alerts";
}

<div class="dash-row row-bottom">
    <div class="card-panel table-panel" style="flex: 1 1 100%;">
        <h3>SMS Alerts</h3>
        <p class="text-muted">
            SMS alerts are created by asking the <a href="/Reports">AI Chat</a> to text you when a condition is met
            (e.g. "text me at 555-123-4567 if the basement humidity goes above 70%"). They run continuously in the
            background and text the number you gave whenever the condition is true.
        </p>
        <ul class="sensors-list" id="alertsList">
            @if (Model.Alerts.Count == 0)
            {
                <li class="sensors-empty">No SMS alerts yet. Ask the AI Chat to set one up for you.</li>
            }
            else
            {
                foreach (var a in Model.Alerts)
                {
                    <li class="sensor-list-item" style="display:flex; align-items:center; justify-content:space-between; gap:8px;" data-alert-id="@a.Id">
                        <span style="overflow:hidden;">
                            <span class="sensor-list-name">@a.Description</span>
                            <span class="sensor-list-type">Texts @a.PhoneNumber &middot; created @a.CreatedAt.ToString("MMM d, yyyy h:mm tt")</span>
                            @if (a.LastTriggeredAt.HasValue)
                            {
                                <span class="sensor-list-type">Last sent @a.LastTriggeredAt.Value.ToString("MMM d, h:mm tt")</span>
                            }
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-danger delete-alert-btn" data-alert-id="@a.Id" data-alert-description="@a.Description">Delete</button>
                    </li>
                }
            }
        </ul>
    </div>
</div>

<!-- ===================== Delete Alert Confirm Modal ===================== -->
<div class="modal fade" id="deleteAlertModal" tabindex="-1" aria-labelledby="deleteAlertModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteAlertModalLabel">Delete Alert</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete "<span id="deleteAlertDescription"></span>"? This cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteAlertBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var alertsList = document.getElementById('alertsList');
            var deleteAlertModalEl = document.getElementById('deleteAlertModal');
            var deleteAlertDescription = document.getElementById('deleteAlertDescription');
            var confirmDeleteAlertBtn = document.getElementById('confirmDeleteAlertBtn');
            var alertIdPendingDelete = null;

            alertsList.addEventListener('click', function (e) {
                var deleteBtn = e.target.closest('.delete-alert-btn');
                if (!deleteBtn) return;
                alertIdPendingDelete = deleteBtn.getAttribute('data-alert-id');
                deleteAlertDescription.textContent = deleteBtn.getAttribute('data-alert-description') || '';
                bootstrap.Modal.getOrCreateInstance(deleteAlertModalEl).show();
            });

            confirmDeleteAlertBtn.addEventListener('click', function () {
                if (!alertIdPendingDelete) return;
                var idToDelete = alertIdPendingDelete;
                confirmDeleteAlertBtn.disabled = true;

                fetch('/Alerts/Delete?id=' + encodeURIComponent(idToDelete), {
                    method: 'POST'
                })
                    .then(function (resp) { if (!resp.ok) throw new Error('Request failed'); return resp.json(); })
                    .then(function () {
                        var item = alertsList.querySelector('[data-alert-id="' + idToDelete + '"]');
                        if (item) { item.remove(); }
                        if (!alertsList.querySelector('[data-alert-id]')) {
                            alertsList.innerHTML = '<li class="sensors-empty">No SMS alerts yet. Ask the AI Chat to set one up for you.</li>';
                        }
                        bootstrap.Modal.getOrCreateInstance(deleteAlertModalEl).hide();
                    })
                    .catch(function () {
                        alert('Unable to delete that alert right now. Please try again.');
                    })
                    .finally(function () {
                        confirmDeleteAlertBtn.disabled = false;
                        alertIdPendingDelete = null;
                    });
            });
        })();
    </script>
}
