<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ESP32 Environmental Monitor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="brand-icon">&#128225;</span>
                <span class="brand-text">ESP32 Environmental Monitor</span>
            </div>
            <nav class="sidebar-nav">
                <a class="nav-item" href="/" id="dashboardNavLink" data-path="/">
                    <span class="nav-icon">&#127968;</span> Dashboard
                </a>
                <a class="nav-item" href="#" id="sensorsNavLink" data-bs-toggle="modal" data-bs-target="#sensorsModal">
                    <span class="nav-icon">&#128225;</span> Sensors
                </a>

                <a class="nav-item" href="#" id="downloadDataNavLink" data-bs-toggle="modal" data-bs-target="#downloadDataModal">
                    <span class="nav-icon">&#128203;</span> Data
                </a>

                <a class="nav-item" href="/Readings" id="readingsNavLink" data-path="/Readings">
                    <span class="nav-icon">&#128202;</span> Recent Readings
                </a>

                <a class="nav-item" href="/Reports" id="reportsNavLink" data-path="/Reports">
                    <span class="nav-icon">&#128200;</span> AI Chat
                </a>
                <a class="nav-item" href="/Alerts" id="alertsNavLink" data-path="/Alerts">
                    <span class="nav-icon">&#128276;</span> Alerts
                </a>
                <a class="nav-item" href="#" id="settingsNavLink">
                    <span class="nav-icon">&#9881;</span> Settings
                </a>
            </nav>

            <div class="sidebar-status">
                <div class="status-title">Data Status</div>
                <div class="status-line"><span class="status-dot"></span> All systems operational</div>
                <div class="status-sub">Last data received</div>
                <div class="status-time">@ViewData["LastDataTime"]</div>
            </div>
        </aside>

        <div class="main-col">
            <header class="topbar">
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-right">
                    <span class="topbar-time">Last Data Received: @ViewData["HeaderTime"]</span>
                    <span class="topbar-user">&#128100; guest &#9662;</span>

                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 ESP32 Environmental Monitor &nbsp;|&nbsp; Built with ASP.NET Core MVC &nbsp;|&nbsp; Data updated every 30 seconds
            </footer>
        </div>
    </div>

    <!-- ===================== Download Data Confirm Modal ===================== -->
    <div class="modal fade" id="downloadDataModal" tabindex="-1" aria-labelledby="downloadDataModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="downloadDataModalLabel">
                        <span class="nav-icon">&#128203;</span> Download Data
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to download all sensor data as a CSV file?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <a href="/Dashboard/DownloadCsv" download id="downloadCsvBtn" class="btn btn-primary">Download</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== Sensors Modal ===================== -->
    <div class="modal fade" id="sensorsModal" tabindex="-1" aria-labelledby="sensorsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content sensors-modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="sensorsModalLabel">
                        <span class="nav-icon">&#128225;</span> Sensors
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul class="sensors-list" id="sensorsList">
                        <li class="sensors-loading">Loading sensors&hellip;</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            // Highlight whichever sidebar item was last interacted with, so the
            // blue "active" bar moves from Dashboard to whatever the user picked,
            // and persists that choice across full page navigations.
            var navItems = Array.prototype.slice.call(document.querySelectorAll('.sidebar-nav .nav-item'));
            var storageKey = 'lastActiveNavItemId';
            var currentPath = window.location.pathname.replace(/\/+$/, '') || '/';

            function setActive(item) {
                navItems.forEach(function (el) {
                    el.classList.remove('active');
                });
                if (item) {
                    item.classList.add('active');
                    if (item.id) {
                        localStorage.setItem(storageKey, item.id);
                    }
                }
            }

            // Prefer matching the current URL to a real navigation link.
            var matchedByPath = navItems.find(function (el) {
                var path = el.getAttribute('data-path');
                if (!path) return false;
                var normalized = path.replace(/\/+$/, '') || '/';
                return normalized === currentPath;
            });

            if (matchedByPath) {
                setActive(matchedByPath);
            } else {
                var lastId = localStorage.getItem(storageKey);
                var lastItem = lastId ? document.getElementById(lastId) : null;
                setActive(lastItem || document.getElementById('dashboardNavLink'));
            }

            navItems.forEach(function (el) {
                el.addEventListener('click', function () {
                    setActive(el);
                });
            });
        })();

        (function () {
            // Bootstrap's [data-bs-dismiss="modal"] click handler calls
            // event.preventDefault() on <a> elements before hiding the modal,
            // which blocks the browser's normal navigation/download for the
            // Download link. Instead, close the modal manually shortly after
            // the click so the download request is allowed to proceed first.
            var downloadBtn = document.getElementById('downloadCsvBtn');
            var downloadDataModalEl = document.getElementById('downloadDataModal');
            if (downloadBtn && downloadDataModalEl) {
                downloadBtn.addEventListener('click', function () {
                    setTimeout(function () {
                        var modal = bootstrap.Modal.getOrCreateInstance(downloadDataModalEl);
                        modal.hide();
                    }, 150);
                });
            }
        })();

        (function () {
            var sensorsModalEl = document.getElementById('sensorsModal');
            if (!sensorsModalEl) return;
            var sensorsList = document.getElementById('sensorsList');

            function renderSensors(sensors) {
                if (!sensors || sensors.length === 0) {
                    sensorsList.innerHTML = '<li class="sensors-empty">No sensors found.</li>';
                    return;
                }
                sensorsList.innerHTML = sensors.map(function (s) {
                    var statusClass = s.online ? 'status-online' : 'status-offline';
                    var statusText = s.online ? 'Online' : 'Offline';
                    return (
                        '<li class="sensor-list-item">' +
                            '<span class="sensor-dot" style="background:' + s.colorHex + ';"></span>' +
                            '<span class="sensor-list-name">' + s.name + '</span>' +
                            '<span class="sensor-list-type">' + s.sensorType + '</span>' +
                            '<span class="sensor-list-status ' + statusClass + '">' + statusText + '</span>' +
                        '</li>'
                    );
                }).join('');
            }

            sensorsModalEl.addEventListener('show.bs.modal', function () {
                sensorsList.innerHTML = '<li class="sensors-loading">Loading sensors&hellip;</li>';
                fetch('/Dashboard/Sensors')
                    .then(function (resp) {
                        if (!resp.ok) throw new Error('Request failed');
                        return resp.json();
                    })
                    .then(function (data) {
                        renderSensors(data);
                    })
                    .catch(function () {
                        sensorsList.innerHTML = '<li class="sensors-empty">Unable to load sensors.</li>';
                    });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


